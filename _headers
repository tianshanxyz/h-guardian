# Cloudflare Pages Headers Configuration
# Cache static assets aggressively

# HTML files - moderate cache with revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# CSS files - long cache with immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript files - long cache with immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images - long cache with immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Web fonts - long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# SVG files - long cache
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# JSON files - short cache
/*.json
  Cache-Control: public, max-age=3600

# XML files - short cache
/*.xml
  Cache-Control: public, max-age=3600
